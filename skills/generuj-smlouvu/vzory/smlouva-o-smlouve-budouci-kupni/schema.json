{
  "type": "object",
  "properties": {
    "prodavajici": {
      "$ref": "#/$defs/strana"
    },
    "kupujici": {
      "$ref": "#/$defs/strana"
    },
    "nemovitost": {
      "type": "object",
      "required": [
        "polozky",
        "ku_text",
        "urad_kraj",
        "pracoviste"
      ],
      "properties": {
        "polozky": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "text",
              "odrazka"
            ],
            "properties": {
              "text": {
                "type": "string",
                "description": "Úplný řádek popisu podle aktuálního LV: parcelní číslo, druh pozemku, stavba či jednotka, její právní režim a související podíly. Pokračovací řádek má odrazka=false; popis musí odpovídat převáděnému rozsahu.",
                "minLength": 1,
                "pattern": "\\S"
              },
              "odrazka": {
                "type": "boolean",
                "description": "true = nová odrážka; false = pokračovací řádek bez odrážky"
              }
            }
          }
        },
        "ku_text": {
          "type": "string",
          "description": "např. 'v katastrálním území a obci Sázava' nebo 'v katastrálním území Studánka'",
          "minLength": 1,
          "pattern": "\\S"
        },
        "urad_kraj": {
          "type": "string",
          "description": "např. 'pro Středočeský kraj' (část názvu katastrálního úřadu, neskloňuje se)",
          "minLength": 1,
          "pattern": "\\S"
        },
        "pracoviste": {
          "type": "string",
          "description": "např. 'Benešov'",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "rok": {
      "type": "string",
      "pattern": "^\\d{4}$",
      "description": "Rok podpisu."
    },
    "cena": {
      "type": "object",
      "properties": {
        "celkem": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:0|[1-9]\\d{0,2}(?:\\.\\d{3})*),\\d{2}$",
          "description": "Částka bez Kč, např. 100.000,00."
        },
        "uhrada": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Úplný způsob a lhůty úhrady, zohlední zálohu či závdavek."
        }
      },
      "required": [
        "celkem",
        "uhrada"
      ],
      "additionalProperties": false
    },
    "lhuta": {
      "type": "object",
      "properties": {
        "vyzva_do": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$",
          "description": "Datum DD.MM.RRRR."
        },
        "uzavreni_do": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$",
          "description": "Datum DD.MM.RRRR."
        },
        "doruceni": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Prokazatelný způsob a adresy doručení výzvy pro obě strany."
        }
      },
      "required": [
        "vyzva_do",
        "uzavreni_do",
        "doruceni"
      ],
      "additionalProperties": false
    },
    "predani": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Lhůta, rozhodná událost a podmínky předání; lhůtu uvést slovy i číslem."
    },
    "uschova": {
      "type": "object",
      "properties": {
        "pouzita": {
          "type": "boolean"
        },
        "podminky": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Advokát, složení, výplata a vrácení peněz, návaznost na samostatnou smlouvu."
        }
      },
      "required": [
        "pouzita"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "pouzita": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "podminky"
            ]
          }
        }
      ]
    },
    "zaloha": {
      "type": "object",
      "properties": {
        "typ": {
          "enum": [
            "zaloha",
            "zavdavek",
            "zadna"
          ],
          "description": "Závdavek zajišťuje povinnosti z této smlouvy a musí být skutečně odevzdán při uzavření."
        },
        "castka": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:0|[1-9]\\d{0,2}(?:\\.\\d{3})*),\\d{2}$",
          "description": "Částka bez Kč, např. 100.000,00."
        },
        "prijemce": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Příjemce platby."
        },
        "ucet": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Účet příjemce."
        },
        "splatnost": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Jen záloha: splatnost, lhůta slovy i číslem."
        },
        "odevzdani_potvrzeno": {
          "type": "boolean",
          "description": "Závdavek: true jen po ověření skutečného odevzdání prodávajícímu nejpozději při podpisu."
        }
      },
      "required": [
        "typ"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "typ": {
                "enum": [
                  "zaloha",
                  "zavdavek"
                ]
              }
            }
          },
          "then": {
            "required": [
              "castka",
              "prijemce",
              "ucet"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "typ": {
                "const": "zaloha"
              }
            }
          },
          "then": {
            "required": [
              "splatnost"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "typ": {
                "const": "zavdavek"
              }
            }
          },
          "then": {
            "required": [
              "odevzdani_potvrzeno"
            ],
            "properties": {
              "odevzdani_potvrzeno": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "pokuta": {
      "type": "object",
      "properties": {
        "sjednana": {
          "type": "boolean"
        },
        "castka": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:0|[1-9]\\d{0,2}(?:\\.\\d{3})*),\\d{2}$",
          "description": "Částka bez Kč, např. 100.000,00."
        }
      },
      "required": [
        "sjednana"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "sjednana": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "castka"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "prodavajici",
    "kupujici",
    "nemovitost",
    "rok",
    "cena",
    "lhuta",
    "predani",
    "uschova",
    "zaloha",
    "pokuta"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smlouva o smlouvě budoucí kupní k nemovitosti",
  "$defs": {
    "strana": {
      "type": "object",
      "required": [
        "radek1",
        "radek2",
        "podpis"
      ],
      "properties": {
        "radek1": {
          "type": "string",
          "description": "FO: 'Jméno Příjmení, r.č. XXXXXX/XXXX' | PO: 'Název s.r.o., IČ: XXX XX XXX'",
          "minLength": 1,
          "pattern": "\\S"
        },
        "radek2": {
          "type": "string",
          "description": "FO: 'trvale pobytem <adresa>' | PO: 'se sídlem <adresa>'",
          "minLength": 1,
          "pattern": "\\S"
        },
        "radek3": {
          "type": [
            "string",
            "null"
          ],
          "description": "PO: 'zapsaná v obchodním rejstříku u <soud>, oddíl <X>, vložka <N>' | FO v SÚ: 'státní občanství: ..., místo narození: ...'"
        },
        "radek4": {
          "type": [
            "string",
            "null"
          ],
          "description": "Další identifikace nebo zastoupení strany."
        },
        "radek5": {
          "type": [
            "string",
            "null"
          ],
          "description": "rezerva (další řádek hlavičky)"
        },
        "podpis": {
          "type": "string",
          "description": "Jméno do podpisového bloku (FO: jméno; PO: název firmy)",
          "minLength": 1,
          "pattern": "\\S"
        },
        "podpis_zastupce": {
          "type": [
            "string",
            "null"
          ],
          "description": "PO: '<jméno>, jednatel' pod názvem firmy v podpisu; FO: null"
        },
        "email": {
          "type": "string",
          "description": "Volitelný kontaktní e-mail."
        }
      },
      "additionalProperties": false
    }
  }
}
