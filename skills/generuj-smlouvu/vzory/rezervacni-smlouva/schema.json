{
  "type": "object",
  "properties": {
    "vlastnik": {
      "$ref": "#/$defs/strana"
    },
    "zajemce": {
      "$ref": "#/$defs/strana"
    },
    "nemovitost": {
      "type": "object",
      "required": [
        "polozky",
        "ku_text",
        "urad_kraj",
        "pracoviste"
      ],
      "properties": {
        "polozky": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "text",
              "odrazka"
            ],
            "properties": {
              "text": {
                "type": "string",
                "description": "Úplný řádek popisu podle aktuálního LV: parcelní číslo, druh pozemku, stavba či jednotka, její právní režim a související podíly. Pokračovací řádek má odrazka=false; popis musí odpovídat převáděnému rozsahu.",
                "minLength": 1,
                "pattern": "\\S"
              },
              "odrazka": {
                "type": "boolean",
                "description": "true = nová odrážka; false = pokračovací řádek bez odrážky"
              }
            }
          }
        },
        "ku_text": {
          "type": "string",
          "description": "např. 'v katastrálním území a obci Sázava' nebo 'v katastrálním území Studánka'",
          "minLength": 1,
          "pattern": "\\S"
        },
        "urad_kraj": {
          "type": "string",
          "description": "např. 'pro Středočeský kraj' (část názvu katastrálního úřadu, neskloňuje se)",
          "minLength": 1,
          "pattern": "\\S"
        },
        "pracoviste": {
          "type": "string",
          "description": "např. 'Benešov'",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "rok": {
      "type": "string",
      "pattern": "^\\d{4}$",
      "description": "Rok podpisu."
    },
    "rezervace": {
      "type": "object",
      "properties": {
        "od": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$",
          "description": "Datum DD.MM.RRRR."
        },
        "do": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$",
          "description": "Datum DD.MM.RRRR."
        },
        "nabidkova_cena": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:0|[1-9]\\d{0,2}(?:\\.\\d{3})*),\\d{2}$",
          "description": "Částka bez Kč, např. 100.000,00."
        }
      },
      "required": [
        "od",
        "do",
        "nabidkova_cena"
      ],
      "additionalProperties": false
    },
    "poplatek": {
      "type": "object",
      "properties": {
        "castka": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:0|[1-9]\\d{0,2}(?:\\.\\d{3})*),\\d{2}$",
          "description": "Částka bez Kč, např. 100.000,00."
        },
        "prijemce": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "V tomto dvoustranném vzoru vlastník, odpovídající vlastnik.podpis."
        },
        "ucet": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Účet vlastníka."
        },
        "splatnost": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$",
          "description": "Datum DD.MM.RRRR."
        },
        "ucet_vraceni": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Účet zájemce pro vrácení poplatku."
        },
        "osud": {
          "enum": [
            "zapocteni",
            "vraceni",
            "propadnuti"
          ],
          "description": "zapocteni: při koupi na cenu, jinak vrátit; vraceni: vždy vrátit; propadnuti: při koupi na cenu, jinak vrátit kromě výslovné smluvní pokuty za úmyslné nepravdivé údaje, nikdy jen za nekoupení."
        }
      },
      "required": [
        "castka",
        "prijemce",
        "ucet",
        "splatnost",
        "ucet_vraceni",
        "osud"
      ],
      "additionalProperties": false
    },
    "spotrebitel": {
      "type": "boolean",
      "description": "Zájemce jedná jako spotřebitel."
    },
    "vlastnik_podnikatel": {
      "type": "boolean",
      "description": "Vlastník jedná jako podnikatel."
    },
    "zprostredkovani": {
      "type": "object",
      "properties": {
        "pouzito": {
          "type": "boolean"
        },
        "zprostredkovatel": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Identifikace realitního zprostředkovatele."
        },
        "smlouva": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Označení a datum samostatné smlouvy o realitním zprostředkování."
        }
      },
      "required": [
        "pouzito"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "pouzito": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "zprostredkovatel",
              "smlouva"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "vlastnik",
    "zajemce",
    "nemovitost",
    "rok",
    "rezervace",
    "poplatek",
    "spotrebitel",
    "vlastnik_podnikatel",
    "zprostredkovani"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rezervační smlouva k nemovitosti",
  "$defs": {
    "strana": {
      "type": "object",
      "required": [
        "radek1",
        "radek2",
        "podpis"
      ],
      "properties": {
        "radek1": {
          "type": "string",
          "description": "FO: 'Jméno Příjmení, r.č. XXXXXX/XXXX' | PO: 'Název s.r.o., IČ: XXX XX XXX'",
          "minLength": 1,
          "pattern": "\\S"
        },
        "radek2": {
          "type": "string",
          "description": "FO: 'trvale pobytem <adresa>' | PO: 'se sídlem <adresa>'",
          "minLength": 1,
          "pattern": "\\S"
        },
        "radek3": {
          "type": [
            "string",
            "null"
          ],
          "description": "PO: 'zapsaná v obchodním rejstříku u <soud>, oddíl <X>, vložka <N>' | FO v SÚ: 'státní občanství: ..., místo narození: ...'"
        },
        "radek4": {
          "type": [
            "string",
            "null"
          ],
          "description": "Další identifikace nebo zastoupení strany."
        },
        "radek5": {
          "type": [
            "string",
            "null"
          ],
          "description": "rezerva (další řádek hlavičky)"
        },
        "podpis": {
          "type": "string",
          "description": "Jméno do podpisového bloku (FO: jméno; PO: název firmy)",
          "minLength": 1,
          "pattern": "\\S"
        },
        "podpis_zastupce": {
          "type": [
            "string",
            "null"
          ],
          "description": "PO: '<jméno>, jednatel' pod názvem firmy v podpisu; FO: null"
        },
        "email": {
          "type": "string",
          "description": "Volitelný kontaktní e-mail."
        }
      },
      "additionalProperties": false
    }
  }
}
